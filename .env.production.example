# ===== 420Frequency — .env PRODUCTION (Hostinger) =====
# Salin jadi .env di server, isi nilai <...>, lalu: php artisan key:generate

APP_NAME="420Frequency"
APP_ENV=production
APP_KEY=                      # WAJIB diisi: `php artisan key:generate` (atau tempel base64:... dari lokal)
APP_DEBUG=false               # WAJIB false di produksi
APP_URL=https://<domainmu>    # domain asli, HTTPS

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# Log harian + simpan 30 hari. WAJIB 'daily' di produksi — dengan 'single' (bawaan)
# semua error menumpuk di satu laravel.log yang tumbuh tanpa batas dan berat dibuka.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=error

# ---- Database (buat di hPanel: DB + user) ----
DB_CONNECTION=mysql
DB_HOST=localhost             # Hostinger biasanya localhost
DB_PORT=3306
DB_DATABASE=<nama_db_hostinger>
DB_USERNAME=<user_db_hostinger>
DB_PASSWORD=<password_kuat>

# ---- Session / Cache / Queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # karena HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=sync         # shared hosting tanpa worker: 'sync' aman (job jalan inline).
                              # Kalau ada worker (queue:work via supervisor), boleh 'database'.

FILESYSTEM_DISK=public

# ---- Email ----
# Belum pakai SMTP: 'log' = email TIDAK terkirim, hanya dicatat di storage/logs.
# Konsekuensi: fitur "Lupa password" tidak berfungsi — reset password dilakukan
# admin 420F lewat menu Users (tombol Reset password).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<domainmu>"
MAIL_FROM_NAME="${APP_NAME}"

# Bila nanti punya SMTP asli, ganti MAIL_MAILER=smtp dan isi baris di bawah:
# MAIL_MAILER=smtp
# MAIL_HOST=<smtp_host>
# MAIL_PORT=587
# MAIL_USERNAME=<smtp_user>
# MAIL_PASSWORD=<smtp_pass>
# MAIL_ENCRYPTION=tls

# ---- Notifikasi WhatsApp (opsional, Fonnte) ----
# Kosongkan bila belum dipakai — tanpa token hanya menulis log (aman, tak error).
FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
